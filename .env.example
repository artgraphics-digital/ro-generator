# ──────────────────────────────────────────────────────────────────
# Environment Variables for RO Generator
# ──────────────────────────────────────────────────────────────────
# DO NOT commit a filled-in .env file to git.
# For local development: copy this file to ".env" and fill in values.
# For Netlify production: set these in:
#   Netlify Dashboard → Site Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Gemini model to use (fallbacks: gemini-3.5-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Local development port (not used on Netlify)
PORT=3000
